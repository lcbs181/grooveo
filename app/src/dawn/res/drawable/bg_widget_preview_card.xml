<?xml version="1.0" encoding="utf-8"?>
<!-- Picker preview card for Dawn Music: same sunrise gradient as the live widget. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <gradient
        android:angle="270"
        android:startColor="@color/widget_card_start"
        android:centerColor="@color/widget_card_center"
        android:endColor="@color/widget_card_end"
        android:type="linear" />
    <corners android:radius="24dp" />
    <stroke android:width="1dp" android:color="@color/widget_card_stroke" />
</shape>
