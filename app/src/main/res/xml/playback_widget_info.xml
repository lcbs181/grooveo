<?xml version="1.0" encoding="utf-8"?>
<!-- minWidth/minHeight follow the standard (cells * 70) - 30 dp formula launchers
     use to size a widget's default placement in cells. Default placement is now
     the large 4x2 variant (250x110dp, cover+title/artist+transport+progress -
     see PlaybackWidget's LargeWidgetContent); resizeMode/minResize* let the user
     drag it down to the compact 2x1 variant (110x40dp, cover+play/pause only -
     see CompactWidgetContent) matching the design's two named breakpoints. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="40dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:initialLayout="@layout/playback_widget_loading"
    android:previewLayout="@layout/playback_widget_preview"
    android:updatePeriodMillis="0" />
