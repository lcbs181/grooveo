<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MusicAgent" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- Android 12+ SplashScreen API (backported pre-31 via core-splashscreen) -
     see MainActivity's installSplashScreen() call. windowSplashScreenAnimatedIcon
     is the full rounded gradient "badge" mark (ic_splash_logo_mark), not just
     the bare bars, since the SplashScreen API only supports one flat background
     color plus one icon drawable, so the badge shape/gradient is baked into
     the icon drawable itself rather than layered on top of the background.
     postSplashScreenTheme hands off to the real app theme once the splash
     dismisses. -->
    <style name="Theme.MusicAgent.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/launcher_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo_mark</item>
        <item name="postSplashScreenTheme">@style/Theme.MusicAgent</item>
    </style>
</resources>
