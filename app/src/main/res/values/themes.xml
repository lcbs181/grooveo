<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MusicAgent" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- Android 12+ SplashScreen API (backported pre-31 via core-splashscreen) -
     see MainActivity's installSplashScreen() call. windowSplashScreenAnimatedIcon
     is the same 5-bar mark as the launcher icon; postSplashScreenTheme hands off
     to the real app theme once the splash dismisses. -->
    <style name="Theme.MusicAgent.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/launcher_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.MusicAgent</item>
    </style>
</resources>
