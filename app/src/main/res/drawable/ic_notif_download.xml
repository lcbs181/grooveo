<?xml version="1.0" encoding="utf-8"?>
<!-- Notification action icon for the "Herunterladen" custom session command (see
     PlaybackService's downloadButton()) - CommandButton has no built-in @Icon
     constant for "download" (unlike ICON_HEART_FILLED/UNFILLED), so this is set via
     CommandButton.Builder().setIconResId() instead. Plain Material "file_download"
     glyph, flat white fill so the system can tint it like any other notification
     action icon. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFF">
    <path android:fillColor="#FF000000" android:pathData="M5,20h14v-2L5,18v2zM19,9h-4L15,3L9,3v6L5,9l7,7 7,-7z" />
</vector>
