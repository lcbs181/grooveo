<?xml version="1.0" encoding="utf-8"?>
<!-- Combined "logo badge" graphic for the Android SplashScreen API -
     windowSplashScreenAnimatedIcon (themes.xml) can only point at a single
     drawable (unlike the adaptive launcher icon's separate background +
     foreground layers), so this bakes the rounded-rect gradient badge and the
     five bars into one vector.

     Matches the Canopy handoff's badge: a 64px box with a 17px radius and
     linear-gradient(160deg, accent-300 -> bg 70%), scaled onto the same
     108-unit viewport ic_launcher_foreground.xml uses so the bars keep that
     file's exact geometry (radius 17/64*108 ≈ 29).

     Bars follow logo direction "A (Pegel)": standing on a y=74 baseline at the
     handoff's 0.43/0.73/1/0.63/0.33 height ratios, with the tallest centre bar
     in coral accent-2. Round-capped strokes give the design's fully-rounded
     bar ends without hand-authoring arc path data.

     Gradient fill on a vector path (via aapt:attr) requires API 24+, safely
     below this project's minSdk 30. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M29,0 H79 A29,29 0 0 1 108,29 V79 A29,29 0 0 1 79,108 H29 A29,29 0 0 1 0,79 V29 A29,29 0 0 1 29,0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="28"
                android:startY="-18"
                android:endX="80"
                android:endY="126"
                android:tileMode="clamp">
                <!-- accent-300 in the dark palette -->
                <item android:offset="0" android:color="#254C40" />
                <item android:offset="0.7" android:color="@color/launcher_background" />
                <item android:offset="1" android:color="@color/launcher_background" />
            </gradient>
        </aapt:attr>
    </path>
    <path
        android:strokeColor="@color/canopy_accent"
        android:strokeWidth="8"
        android:strokeLineCap="round"
        android:pathData="M26,61 L26,74" />
    <path
        android:strokeColor="@color/canopy_accent"
        android:strokeWidth="8"
        android:strokeLineCap="round"
        android:pathData="M40,47 L40,74" />
    <path
        android:strokeColor="@color/canopy_accent_2"
        android:strokeWidth="8"
        android:strokeLineCap="round"
        android:pathData="M54,34 L54,74" />
    <path
        android:strokeColor="@color/canopy_accent"
        android:strokeWidth="8"
        android:strokeLineCap="round"
        android:pathData="M68,52 L68,74" />
    <path
        android:strokeColor="@color/canopy_accent"
        android:strokeWidth="8"
        android:strokeLineCap="round"
        android:pathData="M82,66 L82,74" />
</vector>
