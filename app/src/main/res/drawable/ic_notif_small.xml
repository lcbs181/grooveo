<?xml version="1.0" encoding="utf-8"?>
<!-- Small status-bar icon for plain NotificationCompat notifications this app posts
     itself outside of Media3's own media notification - currently just the
     "Updates" channel (see UpdateCheckWorker). Deliberately a NEW, separate file
     from the launcher-icon assets (ic_launcher_monochrome.xml etc.) even though it
     draws a similar simplified waveform mark, so it doesn't collide with any
     parallel work on the actual launcher icon files. Status bar icons must be a
     flat single-color silhouette, which this already is. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFF">
    <path android:fillColor="#FF000000" android:pathData="M4,10h2v4h-2z" />
    <path android:fillColor="#FF000000" android:pathData="M8,7h2v10h-2z" />
    <path android:fillColor="#FF000000" android:pathData="M12,4h2v16h-2z" />
    <path android:fillColor="#FF000000" android:pathData="M16,7h2v10h-2z" />
    <path android:fillColor="#FF000000" android:pathData="M20,10h2v4h-2z" />
</vector>
